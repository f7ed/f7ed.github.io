---
import '../styles/global.css';
import Publication from '../components/Publication.astro';
import { publications } from '../data/publications';

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Freya Liu — PhD student in Computer Science at Carnegie Mellon University working on cryptography, privacy-preserving systems, and verifiable computation."
    />
    <title>Freya Liu · Cryptography & Systems</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="wordmark" href="/">FL</a>
        <nav aria-label="Primary navigation">
          <a href="#about">About</a>
          <a href="#publications">Publications</a>
          <a href="#experience">Experience</a>
          <a href="https://f7ed.github.io/blog/">Blog ↗</a>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="page-title">
          <div class="hero-main">
            <p class="eyebrow">Carnegie Mellon University · Computer Science</p>
            <h1 id="page-title">Freya<br />Liu</h1>
            <p class="full-name">Fengrun Liu</p>
          </div>

          <div class="hero-side">
            <div class="portrait-frame" aria-label="Profile photo preview area">
              <span>profile photo</span>
            </div>
            <div class="hero-copy">
              <p class="role">PhD student · Cryptography · Systems</p>
              <p class="intro">
                I design and build efficient cryptographic systems, with interests
                spanning privacy-preserving computation, zero-knowledge proofs,
                lattice-based cryptography, and verifiable computation.
              </p>
              <p class="intro secondary">
                My work combines protocol design with practical systems implementation.
              </p>
              <div class="links">
                <a class="inline-link" href="mailto:freya@cmu.edu">Email</a>
                <a class="inline-link" href="https://github.com/f7ed" target="_blank" rel="noreferrer">GitHub</a>
                <a class="inline-link" href="https://f7ed.github.io/blog/">Blog ↗</a>
              </div>
            </div>
          </div>
        </section>

        <section class="section" id="about">
          <div class="section-label">
            <p class="section-index">00</p>
            <h2>About</h2>
          </div>
          <div class="section-body">
            <p class="lead">
              I am a PhD student in Computer Science at Carnegie Mellon University,
              advised by Prof. Wenting Zheng.
            </p>
            <p class="body-copy">
              I am broadly interested in cryptographic systems that are both
              theoretically well-founded and practically efficient. My previous work
              includes multi-party computation for machine learning, verifiable TFHE
              computation, and lattice-based polynomial commitments.
            </p>
            <div class="focus-list" aria-label="Research interests">
              <span>cryptographic systems</span>
              <span>privacy-preserving computation</span>
              <span>zero-knowledge proofs</span>
              <span>verifiable computation</span>
              <span>high-performance implementation</span>
            </div>
          </div>
        </section>

        <section class="section" id="publications">
          <div class="section-label">
            <p class="section-index">01</p>
            <h2>Selected publications</h2>
          </div>
          <div class="section-body">
            {publications.map((publication, index) => (
              <Publication publication={publication} index={index} />
            ))}
            <p class="section-note">
              PDF, code, ePrint, BibTeX, and expandable abstracts can be added to each entry.
            </p>
          </div>
        </section>

        <section class="section" id="experience">
          <div class="section-label">
            <p class="section-index">02</p>
            <h2>Experience</h2>
          </div>
          <div class="section-body">
            <article class="experience-item">
              <div class="experience-heading">
                <h3>LayerZero</h3>
                <span>Cryptography Intern · Summer 2026</span>
              </div>
              <p>
                Contributed to Akita, a high-performance lattice-based polynomial
                commitment scheme, with a focus on GPU-friendly protocol design,
                verifier optimization, and implementation documentation.
              </p>
            </article>

            <article class="experience-item">
              <div class="experience-heading">
                <h3>HasteBoots</h3>
                <span>Research · 2024–2025</span>
              </div>
              <p>
                Led protocol design and implementation of a succinct proof system for
                verifying TFHE programmable bootstrapping, including PIOPs for
                negacyclic NTT and batched arithmetic over quotient rings.
              </p>
            </article>

            <article class="experience-item">
              <div class="experience-heading">
                <h3>Privacy-Preserving ML</h3>
                <span>Research · 2023</span>
              </div>
              <p>
                Designed and implemented scalable MPC protocols for private neural-network
                inference and evaluated a 15.4k-line C++ framework across 3–63 parties.
              </p>
            </article>
          </div>
        </section>

        <section class="section" id="education">
          <div class="section-label">
            <p class="section-index">03</p>
            <h2>Education</h2>
          </div>
          <div class="section-body education-list">
            <div>
              <strong>Carnegie Mellon University</strong>
              <span>PhD student in Computer Science · 2025–present</span>
            </div>
            <div>
              <strong>University of Science and Technology of China</strong>
              <span>M.Eng. in Cyberspace Security · 2022–2025</span>
            </div>
            <div>
              <strong>University of Electronic Science and Technology of China</strong>
              <span>B.Eng. in Software Engineering · 2018–2022</span>
            </div>
          </div>
        </section>

        <section class="section" id="writing">
          <div class="section-label">
            <p class="section-index">04</p>
            <h2>Writing</h2>
          </div>
          <div class="section-body">
            <a class="writing-link" href="https://f7ed.github.io/blog/">
              Technical notes & older writing <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      </main>

      <footer>
        <span>© {year} Freya Liu</span>
        <span>
          Built with Astro · Design inspiration:
          <a href="https://gfenzi.io/" target="_blank" rel="noreferrer">Giacomo Fenzi</a>
        </span>
      </footer>
    </div>
  </body>
</html>
